{
  "private": true,
  "type": "module",
  "imports": {
    "#app.css": "./resources/css/app.css"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "codegen": "graphql-codegen --config codegen.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e:storybook": "cd e2e && pnpm run test:storybook",
    "test:e2e:storybook:ui": "cd e2e && pnpm run test:storybook:ui",
    "test:e2e:storybook:debug": "cd e2e && pnpm run test:storybook:debug",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint 'resources/js/Composables/*.ts' 'resources/js/Types/*.ts' 'resources/js/Components/*.vue' 'resources/js/Components/Teams/*.vue' 'resources/js/Components/Users/*.vue' 'resources/js/Pages/Articles/**/*.vue' 'resources/js/Pages/Users/**/*.vue'",
    "lint:fix": "eslint 'resources/js/Composables/*.ts' 'resources/js/Types/*.ts' 'resources/js/Components/*.vue' 'resources/js/Components/Teams/*.vue' 'resources/js/Components/Users/*.vue' 'resources/js/Pages/Articles/**/*.vue' 'resources/js/Pages/Users/**/*.vue' --fix",
    "format": "prettier --write resources/js/",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "rulesync": "npx rulesync generate --cursor && npx rulesync generate --copilot && npx rulesync generate --claudecode"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.0",
    "@graphql-codegen/client-preset": "6.1.3",
    "@graphql-codegen/introspection": "6.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@inertiajs/vue3": "^3.7.0",
    "@mdi/font": "^7.4.47",
    "@mdx-js/react": "^3.1.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/vue3-vite": "^10.6.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/dc": "^4.2.5",
    "@types/google.maps": "^3.66.2",
    "@types/lodash": "^4.17.25",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/browser": "5.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "axios": "^1.20.0",
    "concurrently": "^9.2.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-storybook": "10.6.0",
    "eslint-plugin-vue": "^10.11.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "laravel-vite-plugin": "^3.2.0",
    "lint-staged": "^17.5.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass-embedded": "^1.104.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "unplugin-vue-macros": "^2.14.5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "~3.2.9"
  },
  "dependencies": {
    "@apollo/client": "^4.2.12",
    "@element-plus/icons-vue": "^2.3.2",
    "@vue/apollo-composable": "^5.0.0-alpha.4",
    "@vueuse/core": "^14.4.0",
    "animate.css": "^4.1.1",
    "crossfilter2": "^1.5.4",
    "d3": "^7.9.0",
    "dayjs": "^1.11.23",
    "dc": "^4.2.7",
    "element-plus": "^2.14.5",
    "graphql": "^17.0.2",
    "graphql-tag": "^2.12.7",
    "jquery": "^3.7.1",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "string-width": "^8.2.2",
    "virtual-keyboard": "^1.30.4",
    "vue3-google-map": "^0.23.1",
    "vuetify": "^4.2.0",
    "wanakana": "^5.3.1"
  },
  "lint-staged": {
    "app/**/*.php": [
      "composer cs-fix"
    ],
    "resources/js/Composables/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "resources/js/Types/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "resources/js/Components/*.vue": [
      "eslint --fix",
      "prettier --write"
    ],
    "resources/js/Pages/Articles/**/*.vue": [
      "eslint --fix",
      "prettier --write"
    ],
    "resources/js/Pages/Users/**/*.vue": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
