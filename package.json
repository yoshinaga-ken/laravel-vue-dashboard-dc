{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "codegen": "graphql-codegen --config codegen.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e:storybook": "cd e2e && pnpm run test:storybook",
    "test:e2e:storybook:ui": "cd e2e && pnpm run test:storybook:ui",
    "test:e2e:storybook:debug": "cd e2e && pnpm run test:storybook:debug",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint 'resources/js/Composables/*.ts' 'resources/js/Types/*.ts' 'resources/js/Components/*.vue' 'resources/js/Components/Teams/*.vue' 'resources/js/Components/Users/*.vue' 'resources/js/Pages/Articles/**/*.vue' 'resources/js/Pages/Users/**/*.vue'",
    "lint:fix": "eslint 'resources/js/Composables/*.ts' 'resources/js/Types/*.ts' 'resources/js/Components/*.vue' 'resources/js/Components/Teams/*.vue' 'resources/js/Components/Users/*.vue' 'resources/js/Pages/Articles/**/*.vue' 'resources/js/Pages/Users/**/*.vue' --fix",
    "format": "prettier --write resources/js/",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "rulesync": "npx rulesync generate --cursor && npx rulesync generate --copilot && npx rulesync generate --claudecode"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.1",
    "@eslint/js": "^9.34.0",
    "@graphql-codegen/cli": "5.0.5",
    "@graphql-codegen/client-preset": "4.8.3",
    "@graphql-codegen/introspection": "4.0.3",
    "@inertiajs/vue3": "^2.1.2",
    "@mdi/font": "^7.4.47",
    "@mdx-js/react": "^3.1.0",
    "@storybook/addon-a11y": "9.0.18",
    "@storybook/addon-docs": "9.0.18",
    "@storybook/addon-essentials": "9.0.0-alpha.12",
    "@storybook/addon-interactions": "9.0.0-alpha.10",
    "@storybook/addon-links": "9.0.18",
    "@storybook/addon-onboarding": "9.0.18",
    "@storybook/addon-themes": "9.0.18",
    "@storybook/addon-vitest": "9.0.18",
    "@storybook/test": "^8.6.14",
    "@storybook/vue3": "9.0.18",
    "@storybook/vue3-vite": "9.0.18",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/d3": "^7.4.3",
    "@types/dc": "^4.2.5",
    "@types/google.maps": "^3.58.1",
    "@types/lodash": "^4.17.20",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.0.1",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "axios": "^1.11.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.4.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "laravel-vite-plugin": "^2.0.0",
    "lint-staged": "^16.1.5",
    "playwright": "^1.55.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sass-embedded": "^1.90.0",
    "storybook": "9.0.18",
    "tailwindcss": "^3.4.17",
    "unplugin-vue-macros": "^2.14.5",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.19",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.6"
  },
  "dependencies": {
    "@apollo/client": "^3.14.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-resolvers": "^4.5.1",
    "@vue/apollo-composable": "^4.2.2",
    "@vue/apollo-util": "^4.2.2",
    "@vueuse/core": "^13.7.0",
    "animate.css": "^4.1.1",
    "crossfilter2": "^1.5.4",
    "d3": "^7.9.0",
    "dayjs": "^1.11.13",
    "dc": "^4.2.7",
    "element-plus": "^2.11.1",
    "graphql": "^16.11.0",
    "graphql-tag": "^2.12.6",
    "jquery": "^3.7.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "string-width": "^8.0.0",
    "virtual-keyboard": "^1.30.4",
    "vue3-google-map": "^0.23.1",
    "vuetify": "^3.9.5",
    "wanakana": "^5.3.1"
  },
  "lint-staged": {
    "app/**/*.php": [
      "composer cs-fix"
    ],
    "resources/js/Composables/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "resources/js/Types/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "resources/js/Components/*.vue": [
      "eslint --fix",
      "prettier --write"
    ],
    "resources/js/Pages/Articles/**/*.vue": [
      "eslint --fix",
      "prettier --write"
    ],
    "resources/js/Pages/Users/**/*.vue": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
